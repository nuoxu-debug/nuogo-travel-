# Nuogo runtime
NODE_ENV=development
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string
DEMO_MODE=true
AI_PROVIDER=demo

# OpenRouter live AI adapter
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=tencent/hy3:free
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_STRUCTURED_OUTPUT=false

# Server-only travel data adapters
TRAVEL_DATA_PROVIDER=demo
TRAVEL_PROVIDER_TIMEOUT_MS=8000
AMAP_WEB_SERVICE_KEY=replace-with-your-amap-web-service-key
OPENTRIPMAP_API_KEY=replace-with-your-opentripmap-api-key

# Amap browser renderer
VITE_AMAP_KEY=

# MySQL live repository
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nuogo
MYSQL_USER=nuogo
MYSQL_PASSWORD=

# Frontend API
VITE_API_URL=http://localhost:8787/api

# Bounded Anhui attraction ingestion
ATTRACTION_SQLITE_PATH=
ATTRACTION_MEDIA_STORAGE_PATH=
INGESTION_DELAY_MS=2500
ENABLE_LEGACY_FEATURES=false
VITE_ENABLE_LEGACY_FEATURES=false
