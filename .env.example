APP_RUNTIME_MODE=live
PORT=8787
CLIENT_ORIGIN=http://localhost:5173
# Render production:
# CLIENT_ORIGIN=https://nuoxu-debug.github.io

# GitHub Pages frontend build:
# Set this as a GitHub Actions repository VARIABLE, then rebuild Pages.
# It is public and must point to the actual deployed backend, including /api.
# VITE_API_URL=https://<your-render-service>.onrender.com/api
# VITE_BASE_PATH=/nuogo-travel-/

DEMO_ADMIN_EMAIL=<optional-demo-admin-email>
DEMO_ADMIN_PASSWORD=<optional-demo-admin-password>

DATABASE_PROVIDER=supabase
# Copy the Supabase connection string (session pooler port 5432 for IPv4).
# URL-encode special characters in the database password.
DATABASE_URL=postgresql://<user>:<password>@<supabase-pooler-host>:5432/postgres

JWT_SECRET=<at-least-32-random-characters>

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=<your-openrouter-api-key>
OPENROUTER_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_STRUCTURED_OUTPUT=true

TRAVEL_DATA_PROVIDER=database
# Optional: only used with TRAVEL_DATA_PROVIDER=live.
OPENTRIPMAP_API_KEY=<your-opentripmap-api-key>
TRAVEL_PROVIDER_TIMEOUT_MS=8000
